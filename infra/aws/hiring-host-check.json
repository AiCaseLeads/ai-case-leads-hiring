{
  "schemaVersion": "2.2",
  "description": "Report aggregate hiring host capacity and application readiness",
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "checkHost",
      "inputs": {
        "timeoutSeconds": "30",
        "runCommand": [
          "set -eu",
          "python3 - <<'PYTHON'",
          "import json, os, subprocess",
          "def space(path):",
          "    usage = os.statvfs(path)",
          "    return {'availableMiB': usage.f_bavail * usage.f_frsize // (1024 * 1024), 'capacityMiB': usage.f_blocks * usage.f_frsize // (1024 * 1024), 'freeInodes': usage.f_favail}",
          "try:",
          "    docker_root = subprocess.check_output(['docker', 'info', '--format', '{{.DockerRootDir}}'], stderr=subprocess.DEVNULL, text=True, timeout=10).strip()",
          "    docker_space = space(docker_root)",
          "except (OSError, subprocess.SubprocessError):",
          "    docker_space = None",
          "probe = \"fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health',{signal:AbortSignal.timeout(5000)}).then(async r=>{const h=await r.json();process.exitCode=r.ok&&h.status==='ready'&&h.checks?.storage===true&&h.checks?.background===true?0:1}).catch(()=>{process.exitCode=1})\"",
          "try:",
          "    ready = subprocess.run(['docker', 'exec', 'hiring', 'node', '-e', probe], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10).returncode == 0",
          "except (OSError, subprocess.SubprocessError):",
          "    ready = False",
          "print(json.dumps({'serviceReady':ready,'root':space('/'),'docker':docker_space,'data':space('/data')}))",
          "PYTHON"
        ]
      }
    }
  ]
}
