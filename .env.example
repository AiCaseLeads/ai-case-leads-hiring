# Blank placeholders for a separate local/server environment.
# Supply secrets through native Sites configuration or the secure admin setup.
# Current hosted encryption/scheduler secrets are already configured; do not replace them.
APPLICATIONS_ENABLED=false
ADMIN_EMAILS=
PUBLIC_SITE_ORIGIN=
EXPECTED_RECRUITING_EMAIL=mariam@aicaseleads.com

# Server secrets only. DB and BUCKET are managed bindings, not values in this file.
# GOOGLE_TOKEN_KEY: 32 random bytes encoded as 64 hex characters; back up securely.
GOOGLE_TOKEN_KEY=
HUB_SCHEDULER_SECRET=

# Optional runtime overrides. Normal setup uses Team & settings to save these encrypted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Applicant bot protection. Set all three on Railway; never use Cloudflare test keys in production.
TURNSTILE_REQUIRED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Automatic applicant receipts and rejections use SendGrid, independently of Google mailboxes.
# Authenticate the company domain and sender in SendGrid first. This key stays server-only.
SENDGRID_API_KEY=
