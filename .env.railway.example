# Railway Variables: paste secret values directly into the dashboard.
# Railway provides PORT and RAILWAY_VOLUME_MOUNT_PATH. Do not fake mount metadata.
# Attach one persistent volume at /data; use one always-running instance.
NODE_ENV=production
DATA_DIR=/data
PUBLIC_SITE_ORIGIN=https://YOUR-SERVICE.up.railway.app
ADMIN_EMAILS=sales@aicaseleads.com
EXPECTED_RECRUITING_EMAIL=sales@aicaseleads.com
APPLICATIONS_ENABLED=false
BACKGROUND_ENABLED=true

# Google Web application client, with both callback URIs from the setup guide.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exactly 64 hexadecimal characters: generated once and backed up securely.
GOOGLE_TOKEN_KEY=

# Optional operator-configured external processor credential. Not needed for
# Railway's built-in queue loop. Keep unset unless using the external API.
# HUB_SCHEDULER_SECRET=

# Independent automatic email, using the existing SendGrid account. Server-only key.
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
# App attempt budget, not a provider-plan allowance.
AUTOMATIC_MAIL_DAILY_LIMIT=300
# Optional paid Email Activity access: enable only when already included/approved.
SENDGRID_EMAIL_ACTIVITY_ENABLED=false
